{
  "name": "spiderman-workspace",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b --force",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm test && node scripts/generate.mjs --check && node scripts/check-package.mjs",
    "pack:all": "node scripts/pack.mjs",
    "generate": "node scripts/generate.mjs",
    "test:browser": "playwright test",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:install": "node scripts/install-smoke.mjs",
    "licenses": "node scripts/licenses.mjs",
    "format": "prettier --write packages scripts tests package.json tsconfig*.json playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3"
  }
}
